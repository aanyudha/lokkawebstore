{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "web/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
