# Example only. Configure TLS separately before production use.
# Fastify: HOST=127.0.0.1, PORT=3000, TRUST_PROXY=true.
server {
    listen 80;
    server_name lokka.id;
    # Fastify retains a 64 KiB form limit; only product upload routes accept 51 MiB.
    client_max_body_size 51m;

    # If Cloudflare is used, configure real_ip only with official, current
    # Cloudflare CIDRs. Never trust CF-Connecting-IP from arbitrary sources.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
