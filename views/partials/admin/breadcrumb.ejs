<nav class="admin-breadcrumb" aria-label="Breadcrumb"><ol>
<% for (const [index, crumb] of breadcrumbs.entries()) { %><li><% if (crumb.href && index !== breadcrumbs.length - 1) { %><a href="<%= crumb.href %>"><%= crumb.label %></a><% } else { %><span <%- index === breadcrumbs.length - 1 ? 'aria-current="page"' : '' %>><%= crumb.label %></span><% } %></li><% } %>
</ol></nav>
