<% const footLocale = locale || 'en'; %>
<% const footT = typeof t === 'function' ? t : (k) => k; %>
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="<%= footLocale === 'id' ? '/id' : '/' %>" class="footer-logo" aria-label="LOKKA">LOKKA</a>
      <p><%= footT('site.copyright') %></p>
    </div>
    <div class="footer-links">
      <div class="footer-col">
        <h4><%= footT('footer.collections') %></h4>
        <a href="<%= footLocale === 'id' ? '/id/koleksi' : '/collections' %>"><%= footT('nav.collections') %></a>
      </div>
      <div class="footer-col">
        <h4><%= footT('footer.about') %></h4>
        <p><%= footT('site.copyright') %></p>
      </div>
    </div>
  </div>
</footer>
