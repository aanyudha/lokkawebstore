<form method="post" action="/admin/products/<%= productId %>/variants<%= variant.id ? '/' + variant.id : '' %>" class="variant-form" aria-describedby="<%= error ? 'form-error' : '' %>">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<label>Nama varian<input name="name" required maxlength="150" value="<%= variant.name || '' %>" placeholder="Ivory / M" />
</label>
<label>SKU<input name="sku" required maxlength="80" value="<%= variant.sku || '' %>" />
</label>
<label>Harga (Rupiah)<input name="price" inputmode="numeric" pattern="[0-9]+" required value="<%= variant.price ?? '' %>" />
</label>
<label>Harga pembanding<input name="compareAtPrice" inputmode="numeric" pattern="[0-9]*" value="<%= variant.compareAtPrice ?? '' %>" />
</label>
<label>Berat (gram)<input name="weightGrams" type="number" min="1" required value="<%= variant.weightGrams ?? '' %>" />
</label>
<label>Stok<input name="stockQuantity" type="number" min="0" required value="<%= variant.stockQuantity ?? 0 %>" />
</label>
<label>Status<select name="status">
<% for (const status of ['active', 'inactive']) { %>
<option <%= variant.status === status ? 'selected' : '' %>>
<%= status %>
</option>
<% } %>
</select>
</label>
<label>Urutan<input name="sortOrder" type="number" min="0" required value="<%= variant.sortOrder ?? 0 %>" />
</label>
<button>
<%= variant.id ? 'Simpan varian' : 'Tambah varian' %>
</button>
</form>
