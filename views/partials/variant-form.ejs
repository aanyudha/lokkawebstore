<form method="post" action="/admin/products/<%= productId %>/variants<%= variant.id ? '/' + variant.id : '' %>" class="variant-form" aria-describedby="<%= error ? 'form-error' : '' %>">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<label>Variant name<input name="name" required maxlength="150" value="<%= variant.name || '' %>" placeholder="Ivory / M" />
</label>
<label>SKU<input name="sku" required maxlength="80" value="<%= variant.sku || '' %>" />
</label>
<label>Price (Rupiah)<input name="price" inputmode="numeric" pattern="[0-9]*" value="<%= variant.price ?? '' %>" />
</label>
<label>Compare-at price<input name="compareAtPrice" inputmode="numeric" pattern="[0-9]*" value="<%= variant.compareAtPrice ?? '' %>" />
</label>
<label>Weight (grams)<input name="weightGrams" type="number" min="0" value="<%= variant.weightGrams ?? '' %>" />
</label>
<label>Stock<input name="stockQuantity" type="number" min="0" required value="<%= variant.stockQuantity ?? 0 %>" />
</label>
<label>Status<select name="status">
<% for (const status of ['active', 'inactive']) { %>
<option <%= (variant.status || 'inactive') === status ? 'selected' : '' %>>
<%= status %>
</option>
<% } %>
</select>
</label>
<label>Sort order<input name="sortOrder" type="number" min="0" required value="<%= variant.sortOrder ?? 0 %>" />
</label>
<button>
<%= variant.id ? 'Save variant' : 'Add variant' %>
</button>
</form>
