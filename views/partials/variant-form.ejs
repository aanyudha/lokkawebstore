<% const knownStock = variant.stockKnown !== false && variant.stockKnown !== 'false'; %>
<form method="post" action="/admin/products/<%= productId %>/variants<%= variant.id ? '/' + variant.id : '' %>" class="variant-form" aria-describedby="<%= error ? 'form-error' : '' %>">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<label>Variant name<input name="name" required maxlength="150" value="<%= variant.name || '' %>" placeholder="Ivory / M" />
</label>
<label>SKU<input name="sku" required maxlength="80" value="<%= variant.sku || '' %>" />
</label>
<label>Price (Rupiah)<input name="price" inputmode="numeric" pattern="[0-9]*" value="<%= variant.price ?? '' %>" />
</label>
<label>Compare-at price<input name="compareAtPrice" inputmode="numeric" pattern="[0-9]*" value="<%= variant.compareAtPrice ?? '' %>" />
</label>
<label>Weight (gram)<input name="weightGrams" aria-label="Weight (gram)" aria-describedby="weight-help-<%= variant.id || 'new' %>" type="number" min="1" value="<%= variant.weightGrams && variant.weightGrams !== '0' ? variant.weightGrams : '' %>" />
<small id="weight-help-<%= variant.id || 'new' %>">Optional. Leave blank if unconfirmed. Required for Webstore selling, never for POS.</small></label>
<label>Unit<input name="unit" maxlength="30" value="<%= variant.unit ?? '' %>" /></label>
<label>Quantity status<select name="stockKnown" data-stock-state><option value="true" <%= knownStock ? 'selected' : '' %>>Known quantity</option><option value="false" <%= !knownStock ? 'selected' : '' %>>Unspecified quantity</option></select></label>
<label>Stock<input name="stockQuantity" type="number" min="0" data-stock-quantity value="<%= !knownStock ? '' : variant.stockQuantity ?? 0 %>" />
</label>
<label>Status<select name="status">
<% for (const status of ['active', 'inactive']) { %>
<option <%= (variant.status || 'inactive') === status ? 'selected' : '' %>>
<%= status %>
</option>
<% } %>
</select>
</label>
<label>Sort order<input name="sortOrder" type="number" min="0" required value="<%= variant.sortOrder ?? 0 %>" />
</label>
<button>
<%= variant.id ? 'Save variant' : 'Add variant' %>
</button>
</form>
