<% const navLocale = locale || 'en'; %>
<% const navT = typeof t === 'function' ? t : (k) => k; %>
<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href="<%= navLocale === 'id' ? '/id' : '/' %>" aria-label="LOKKA">
      <img
        src="/images/brand/lokka-logo.webp"
        alt="LOKKA"
        width="140"
        height="70"
        class="brand-logo"
        onerror="this.onerror=null;this.src='/images/lokka_logo.png';this.width=140;this.height=70;"
      />
    </a>

    <nav class="main-nav" aria-label="<%= navT('language.switchLabel') %>">
      <a href="<%= navLocale === 'id' ? '/id/koleksi' : '/collections' %>"><%= navT('nav.collections') %></a>
      <% for (const cat of (categories || [])) { %>
        <% if (!cat.parentId) { %>
          <a href="<%= navLocale === 'id' ? '/id/kategori/' + cat.slug : '/category/' + cat.slug %>"><%= cat.name %></a>
        <% } %>
      <% } %>
    </nav>

    <div class="header-actions">
      <nav class="lang-switcher" aria-label="<%= navT('language.switchLabel') %>">
        <% for (const loc of (locales || [])) { %>
          <a
            href="<%= loc.pathPrefix || '/' %>"
            class="<%= loc.code === navLocale ? 'lang-active' : '' %>"
            lang="<%= loc.htmlLang %>"
            hreflang="<%= loc.htmlLang %>"
          ><%= loc.code.toUpperCase() %></a>
        <% } %>
      </nav>

      <button
        class="mobile-menu-btn"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        aria-label="Menu"
        data-menu-toggle
      >
        <span class="menu-icon" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>
  </div>

  <div class="mobile-drawer" id="mobile-drawer" hidden>
    <nav aria-label="Mobile navigation">
      <a href="<%= navLocale === 'id' ? '/id/koleksi' : '/collections' %>"><%= navT('nav.collections') %></a>
      <% for (const cat of (categories || [])) { %>
        <% if (!cat.parentId) { %>
          <a href="<%= navLocale === 'id' ? '/id/kategori/' + cat.slug : '/category/' + cat.slug %>"><%= cat.name %></a>
        <% } %>
      <% } %>
      <div class="mobile-lang">
        <% for (const loc of (locales || [])) { %>
          <a
            href="<%= loc.pathPrefix || '/' %>"
            class="<%= loc.code === navLocale ? 'lang-active' : '' %>"
            lang="<%= loc.htmlLang %>"
          ><%= loc.name %></a>
        <% } %>
      </div>
    </nav>
  </div>
</header>
