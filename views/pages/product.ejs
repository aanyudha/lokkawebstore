<% const pdpLocale = locale || 'en'; %>
<% const pdpT = typeof t === 'function' ? t : (k) => k; %>
<% const selectedVariant = variants.find(v => v.stockKnown && v.stockQuantity > 0) || variants[0]; %>
<main id="main" class="catalog-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="<%= pdpLocale === 'id' ? '/id' : '/' %>"><%= pdpT('breadcrumb.home') %></a>
    <span class="breadcrumb-sep" aria-hidden="true">/</span>
    <a href="<%= pdpLocale === 'id' ? '/id/koleksi' : '/collections' %>"><%= pdpT('breadcrumb.collections') %></a>
    <% if (category) { %>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <a href="<%= pdpLocale === 'id' ? '/id/kategori/' + category.slug : '/category/' + category.slug %>"><%= category.name %></a>
    <% } %>
    <span class="breadcrumb-sep" aria-hidden="true">/</span>
    <span aria-current="page"><%= product.name %></span>
  </nav>

  <div class="product-detail">
    <div class="gallery">
      <% if (!images.length) { %>
        <%- include('../partials/product-placeholder.ejs') %>
      <% } %>
      <% images.forEach((picture, index) => { %>
        <img
          src="<%= picture.src %>"
          alt="<%= picture.altText || product.name %>"
          width="<%= picture.width %>"
          height="<%= picture.height %>"
          <% if (index > 0) { %>loading="lazy"<% } %>
          class="gallery__img"
        />
      <% }); %>
    </div>

    <section class="product-copy">
      <p class="eyebrow">LOKKA<% if (category) { %> / <%= category.name %><% } %></p>
      <h1 class="product-title"><%= product.name %></h1>

      <% if (variants.length) { %>
        <p class="detail-price" data-variant-price aria-live="polite"><%= formatIdr(selectedVariant.price) %></p>
        <del class="product-card__compare" data-variant-compare <%= selectedVariant.compareAtPrice > selectedVariant.price ? '' : 'hidden' %>><%= selectedVariant.compareAtPrice > selectedVariant.price ? formatIdr(selectedVariant.compareAtPrice) : '' %></del>
      <% } %>

      <% if (product.shortDescription) { %>
        <p class="product-short-desc"><%= product.shortDescription %></p>
      <% } %>

      <% if (variants.length) { %>
        <form method="post" action="<%= pdpLocale === 'id' ? '/id/keranjang/items' : '/cart/items' %>">
        <input type="hidden" name="csrf" value="<%= typeof customerCsrf === 'undefined' ? '' : customerCsrf %>" />
        <fieldset class="variant-picker">
          <legend><%= pdpT('product.selectVariant') %></legend>
          <% variants.forEach((variant, i) => { %>
            <label class="variant-label">
              <input
                type="radio"
                name="variantId"
                value="<%= variant.id %>"
                data-price="<%= formatIdr(variant.price) %>"
                data-compare="<%= variant.compareAtPrice > variant.price ? formatIdr(variant.compareAtPrice) : '' %>"
                data-sku="<%= variant.sku %>"
                data-stock-known="<%= variant.stockKnown %>"
                data-quantity="<%= variant.stockKnown ? variant.stockQuantity : '' %>"
                data-stock="<%= !variant.stockKnown ? pdpT('shop.unavailable') : variant.stockQuantity > 0 ? pdpT('product.inStock') : pdpT('product.outOfStock') %>"
                <%= i === variants.findIndex(v => v.stockKnown && v.stockQuantity > 0) ? 'checked' : '' %>
              />
              <span><%= variant.name %></span>
            </label>
          <% }); %>
        </fieldset>
        <p class="variant-info" data-variant-info>
          <%= pdpT('product.sku') %>: <%= selectedVariant.sku %> · <%= !selectedVariant.stockKnown ? pdpT('shop.unavailable') : selectedVariant.stockQuantity > 0 ? pdpT('product.inStock') : pdpT('product.outOfStock') %>
        </p>
        <label for="product-quantity"><%= pdpT('shop.quantity') %></label>
        <input id="product-quantity" name="quantity" type="number" min="1" max="<%= variants.find(v => v.stockKnown && v.stockQuantity > 0)?.stockQuantity || 1 %>" value="1" required />
        <button class="btn btn-primary" type="submit" data-add-to-cart <%= variants.every(v => !v.stockKnown || v.stockQuantity <= 0) ? 'disabled' : '' %>><%= pdpT('shop.addToCart') %></button>
        <% if (!customer) { %><p><%= pdpT('shop.loginRequired') %></p><% } %>
        </form>
      <% } else { %>
        <p class="variant-info"><%= pdpT('product.selectVariant') %></p>
      <% } %>


      <% if (product.description) { %>
        <h2 class="section-heading"><%= pdpT('product.aboutThisWork') %></h2>
        <div class="prose"><%= product.description %></div>
      <% } %>
    </section>
  </div>
</main>
