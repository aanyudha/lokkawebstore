<% const accountT = typeof t === 'function' ? t : (k) => k; %>
<% const accountRoutes = routes || {}; %>
<main id="main" class="account">
  <div class="account-shell">
    <section class="account-aside">
      <img
        src="/images/brand/lokka-logo.webp"
        alt="LOKKA"
        width="140"
        height="70"
        class="account-logo"
      />
      <p class="account-eyebrow"><%= accountT('account.profile.eyebrow') %></p>
      <h1 class="account-heading"><%= accountT('account.profile.title') %></h1>
      <p class="account-lead"><%= accountT('account.profile.subtitle') %></p>
      <a class="account-back" href="<%= accountRoutes.home %>"><%= accountT('account.backToAccount') %></a>
    </section>
    <section class="account-panel">
      <% if (notice) { %>
      <div class="account-notice" role="status"><%= notice %></div>
      <% } %>
      <% if (error) { %>
      <div class="account-error" id="form-error" role="alert">
        <strong><%= accountT('account.error.formTitle') %></strong>
        <span><%= accountT(error.message) %></span>
      </div>
      <% } %>
      <form
        method="post"
        action="<%= accountRoutes.profile %>"
        class="account-form"
        aria-describedby="<%= error ? 'form-error' : '' %>"
      >
        <input type="hidden" name="csrf" value="<%= csrf %>" />
        <div class="account-field">
          <label for="profile-name"><%= accountT('account.profile.name') %></label>
          <input
            id="profile-name"
            type="text"
            name="name"
            required
            maxlength="150"
            autocomplete="name"
            value="<%= values.name || '' %>"
            <%= error && error.field === 'name' ? 'aria-invalid="true"' : '' %>
          />
        </div>
        <div class="account-field">
          <label for="profile-email"><%= accountT('account.profile.email') %></label>
          <input
            id="profile-email"
            type="email"
            name="email"
            value="<%= values.email || '' %>"
            maxlength="254"
            autocomplete="email"
            readonly
            aria-describedby="profile-email-note"
          />
          <small id="profile-email-note"><%= accountT('account.profile.emailNote') %></small>
        </div>
        <button class="btn btn-primary account-submit" type="submit">
          <%= accountT('account.profile.submit') %>
        </button>
      </form>
    </section>
  </div>
</main>
