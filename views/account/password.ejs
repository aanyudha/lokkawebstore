<% const accountT = typeof t === 'function' ? t : (k) => k; %>
<% const accountRoutes = routes || {}; %>
<main id="main" class="account">
  <div class="account-shell">
    <section class="account-aside">
      <img
        src="/images/brand/lokka-logo.webp"
        alt="LOKKA"
        width="140"
        height="70"
        class="account-logo"
      />
      <p class="account-eyebrow"><%= accountT('account.password.eyebrow') %></p>
      <h1 class="account-heading"><%= accountT('account.password.title') %></h1>
      <p class="account-lead"><%= accountT('account.password.subtitle') %></p>
      <a class="account-back" href="<%= accountRoutes.home %>"><%= accountT('account.backToAccount') %></a>
    </section>
    <section class="account-panel">
      <% if (error) { %>
      <div class="account-error" id="form-error" role="alert">
        <strong><%= accountT('account.error.formTitle') %></strong>
        <span><%= accountT(error.message) %></span>
      </div>
      <% } %>
      <form
        method="post"
        action="<%= accountRoutes.password %>"
        class="account-form"
        aria-describedby="<%= error ? 'form-error' : '' %>"
      >
        <input type="hidden" name="csrf" value="<%= csrf %>" />
        <div class="account-field">
          <label for="password-current"><%= accountT('account.password.current') %></label>
          <div class="password-field">
            <input
              id="password-current"
              type="password"
              name="currentPassword"
              required
              maxlength="128"
              autocomplete="current-password"
              data-password-input
              <%= error && error.field === 'currentPassword' ? 'aria-invalid="true"' : '' %>
            />
            <button
              type="button"
              class="password-toggle"
              data-password-toggle
              aria-pressed="false"
              data-label-show="<%= accountT('account.button.showPassword') %>"
              data-label-hide="<%= accountT('account.button.hidePassword') %>"
              aria-label="<%= accountT('account.button.showPassword') %>"
            ><%= accountT('account.button.showPassword') %></button>
          </div>
        </div>
        <div class="account-field">
          <label for="password-new"><%= accountT('account.password.new') %></label>
          <div class="password-field">
            <input
              id="password-new"
              type="password"
              name="newPassword"
              required
              minlength="10"
              maxlength="128"
              autocomplete="new-password"
              data-password-input
              aria-describedby="password-new-hint"
              <%= error && error.field === 'newPassword' ? 'aria-invalid="true"' : '' %>
            />
            <button
              type="button"
              class="password-toggle"
              data-password-toggle
              aria-pressed="false"
              data-label-show="<%= accountT('account.button.showPassword') %>"
              data-label-hide="<%= accountT('account.button.hidePassword') %>"
              aria-label="<%= accountT('account.button.showPassword') %>"
            ><%= accountT('account.button.showPassword') %></button>
          </div>
          <small id="password-new-hint"><%= accountT('account.password.hint') %></small>
        </div>
        <div class="account-field">
          <label for="password-confirm"><%= accountT('account.password.confirm') %></label>
          <div class="password-field">
            <input
              id="password-confirm"
              type="password"
              name="confirmPassword"
              required
              minlength="10"
              maxlength="128"
              autocomplete="new-password"
              data-password-input
              <%= error && error.field === 'confirmPassword' ? 'aria-invalid="true"' : '' %>
            />
            <button
              type="button"
              class="password-toggle"
              data-password-toggle
              aria-pressed="false"
              data-label-show="<%= accountT('account.button.showPassword') %>"
              data-label-hide="<%= accountT('account.button.hidePassword') %>"
              aria-label="<%= accountT('account.button.showPassword') %>"
            ><%= accountT('account.button.showPassword') %></button>
          </div>
        </div>
        <button class="btn btn-primary account-submit" type="submit">
          <%= accountT('account.password.submit') %>
        </button>
      </form>
    </section>
  </div>
</main>
