<main id="main" class="catalog-page shop-page">
  <h1><%= order.orderNumber %></h1>
  <p><time datetime="<%= order.createdAt.toISOString() %>"><%= order.createdAt.toLocaleString(locale === 'id' ? 'id-ID' : 'en-GB', { timeZone: 'Asia/Jakarta' }) %> WIB</time></p>
  <p data-order-status><%= t('shop.status.' + order.status) %></p>
  <% if (order.shippingAddressSnapshot) { %>
    <%- include('delivery.ejs', { delivery: order }) %>
  <% } %>
  <% if (order.status === 'PAID') { %>
    <section aria-labelledby="shipment-heading">
      <h2 id="shipment-heading"><%= t('shop.shipment') %></h2>
      <p data-shipment-status><%= t('shop.shipmentStatus.' + (order.shipment?.status ?? 'READY')) %></p>
      <% if (order.shipment) { %>
        <dl>
          <dt><%= t('shop.shippingCourier') %></dt><dd><%= order.shipment.courierName %></dd>
          <dt><%= t('shop.shippingService') %></dt><dd><%= order.shipment.serviceName %></dd>
          <dt><%= t('shop.trackingNumber') %></dt><dd data-tracking-number><%= order.shipment.trackingNumber %></dd>
        </dl>
      <% } %>
    </section>
  <% } %>
  <div class="shop-table-wrap" tabindex="0" role="region" aria-label="<%= t('shop.orders') %>">
    <table class="shop-table">
      <thead><tr><th scope="col"><%= t('shop.product') %></th><th scope="col"><%= t('shop.unitPrice') %></th><th scope="col"><%= t('shop.quantity') %></th><th scope="col"><%= t('shop.lineTotal') %></th></tr></thead>
      <tbody><% for (const item of order.items) { %>
        <tr><th scope="row"><%= item.productNameSnapshot %><br /><small><%= item.variantNameSnapshot %> · SKU: <%= item.skuSnapshot %></small></th><td><%= formatIdr(item.unitPriceSnapshot) %></td><td><%= item.quantity %></td><td><%= formatIdr(item.lineTotalSnapshot) %></td></tr>
      <% } %></tbody>
    </table>
  </div>
  <% if (order.shippingAddressSnapshot) { %>
    <%- include('totals.ejs', { totals: order }) %>
  <% } else { %>
    <p><%= t('shop.subtotal') %>: <%= formatIdr(order.subtotal) %></p>
    <p><%= t('shop.shipping') %>: <%= t('shop.shippingLater') %></p>
    <p class="detail-price"><%= t('shop.grandTotal') %>: <%= formatIdr(order.grandTotal) %></p>
  <% } %>
  <% const orderPath = paths.orders + '/' + order.orderNumber;
     const processing = order.status === 'PENDING_PAYMENT' &&
       (payment?.status === 'CREATED' || (returning && (!payment || payment.status === 'PENDING')));
     const retry = payment && ['FAILED', 'EXPIRED', 'CANCELLED'].includes(payment.status);
     const openAttempt = payment && ['CREATED', 'PENDING', 'REVIEW'].includes(payment.status); %>
  <% if (error) { %><p class="account-error" role="alert"><%= t(error) %></p><% } %>
  <% if (payment || canPay || returning) { %>
    <% const localTime = (date) => date.toLocaleString(locale === 'id' ? 'id-ID' : 'en-GB', { timeZone: 'Asia/Jakarta' }) + ' WIB'; %>
    <section aria-labelledby="order-payment">
      <h2 id="order-payment"><%= t('shop.payment') %></h2>
      <p data-payment-status><%= t(payment ? 'shop.paymentStatus.' + payment.status : 'shop.status.' + order.status) %></p>
      <dl>
        <dt><%= t('shop.paymentProvider') %></dt><dd><%= payment?.provider || 'DOKU' %></dd>
        <dt><%= t('shop.paymentAmount') %></dt><dd><%= formatIdr(payment?.amount ?? order.grandTotal) %></dd>
        <% if (payment) { %>
          <dt><%= t('shop.paymentInitiated') %></dt><dd><time datetime="<%= payment.createdAt.toISOString() %>"><%= localTime(payment.createdAt) %></time></dd>
          <% if (payment.status === 'PAID' && payment.paidAt) { %>
            <dt><%= t('shop.paymentConfirmedAt') %></dt><dd><time datetime="<%= payment.paidAt.toISOString() %>"><%= localTime(payment.paidAt) %></time></dd>
          <% } %>
        <% } %>
      </dl>
      <% if (processing) { %>
        <p role="status"><%= t('shop.paymentProcessing') %></p>
        <p><a href="<%= orderPath %>/payment/return"><%= t('shop.paymentRefresh') %></a></p>
      <% } %>
      <% if (canPay && (!payment || retry || payment.status === 'PENDING')) { %>
        <form method="post" action="<%= orderPath %>/payment">
          <input type="hidden" name="csrf" value="<%= csrf %>" />
          <button class="btn btn-primary" type="submit"><%= t(retry ? 'shop.paymentRetry' : payment ? 'shop.paymentContinue' : 'shop.paymentStart') %></button>
        </form>
      <% } %>
    </section>
  <% } %>
  <% if (order.status === 'PENDING_PAYMENT' && !openAttempt) { %>
    <form method="post" action="<%= paths.orders %>/<%= order.orderNumber %>/cancel">
      <input type="hidden" name="csrf" value="<%= csrf %>" />
      <button class="btn btn-secondary" type="submit"><%= t('shop.cancel') %></button>
    </form>
  <% } %>
  <div class="account-actions"><a href="<%= paths.orders %>"><%= t('shop.orders') %></a><a href="<%= paths.shopping %>"><%= t('shop.continueShopping') %></a></div>
</main>
