<main id="main" class="catalog-page shop-page">
  <h1><%= order.orderNumber %></h1>
  <p><time datetime="<%= order.createdAt.toISOString() %>"><%= localTime(order.createdAt) %></time></p>
  <p data-order-status><%= t('shop.history.status.' + status) %></p>
  <% if (error) { %><p class="account-error" role="alert"><%= t(error) %></p><% } %>

  <section aria-labelledby="order-items">
    <h2 id="order-items"><%= t('shop.history.orderItems') %></h2>
    <div class="shop-table-wrap" tabindex="0" role="region" aria-labelledby="order-items">
      <table class="shop-table">
        <thead><tr><th scope="col"><%= t('shop.product') %></th><th scope="col"><%= t('shop.unitPrice') %></th><th scope="col"><%= t('shop.quantity') %></th><th scope="col"><%= t('shop.lineTotal') %></th></tr></thead>
        <tbody><% for (const item of items) { %>
          <tr><th scope="row"><%= item.productNameSnapshot %><br /><small><%= item.variantNameSnapshot %><% if (item.skuSnapshot) { %> · SKU: <%= item.skuSnapshot %><% } %></small></th><td><%= formatIdr(item.unitPriceSnapshot) %></td><td><%= item.quantity %></td><td><%= formatIdr(item.lineTotalSnapshot) %></td></tr>
        <% } %></tbody>
      </table>
    </div>
    <%- include('totals.ejs', { totals: order, shippingUnavailable: !order.shippingMethodSnapshot }) %>
  </section>

  <% if (order.shippingAddressSnapshot) { %>
    <%- include('delivery.ejs', { delivery: order, historical: true }) %>
  <% } else { %>
    <p><%= t('shop.history.noDelivery') %></p>
  <% } %>

  <% const orderPath = paths.orders + '/' + order.orderNumber; %>
  <section aria-labelledby="order-payment">
    <h2 id="order-payment"><%= t('shop.payment') %></h2>
    <p data-payment-status><%= t(payment ? 'shop.paymentStatus.' + payment.status : 'shop.history.noPayment') %></p>
    <% if (payment || paymentAction) { %>
      <dl>
        <dt><%= t('shop.paymentProvider') %></dt><dd><%= payment?.provider ?? 'DOKU' %></dd>
        <dt><%= t('shop.paymentAmount') %></dt><dd><%= formatIdr(payment?.amount ?? order.grandTotal) %></dd>
        <% if (payment) { %>
          <dt><%= t('shop.paymentInitiated') %></dt><dd><time datetime="<%= payment.createdAt.toISOString() %>"><%= localTime(payment.createdAt) %></time></dd>
          <% if (payment.status === 'PAID' && payment.paidAt) { %>
            <dt><%= t('shop.paymentConfirmedAt') %></dt><dd><time datetime="<%= payment.paidAt.toISOString() %>"><%= localTime(payment.paidAt) %></time></dd>
          <% } %>
        <% } %>
      </dl>
    <% } %>
    <% if (status === 'PAYMENT_PROCESSING') { %>
      <p role="status"><%= t('shop.paymentProcessing') %></p>
      <p><a href="<%= orderPath %>/payment/return"><%= t('shop.paymentRefresh') %></a></p>
    <% } %>
    <% if (paymentAction) { %>
      <form method="post" action="<%= orderPath %>/payment">
        <input type="hidden" name="csrf" value="<%= csrf %>" />
        <button class="btn btn-primary" type="submit"><%= t('shop.' + paymentAction) %></button>
      </form>
    <% } %>
  </section>

  <% if (status === 'PREPARING_ORDER' || shipment) { %>
    <section aria-labelledby="shipment-heading">
      <h2 id="shipment-heading"><%= t('shop.history.actualShipment') %></h2>
      <p data-shipment-status><%= t('shop.shipmentStatus.' + (shipment?.status ?? 'READY')) %></p>
      <% if (shipment) { %>
        <dl>
          <dt><%= t('shop.shippingCourier') %></dt><dd><%= shipment.courierName %></dd>
          <dt><%= t('shop.shippingService') %></dt><dd><%= shipment.serviceName %></dd>
          <dt><%= t('shop.trackingNumber') %></dt><dd data-tracking-number><%= shipment.trackingNumber %></dd>
          <dt><%= t('shop.history.shippedAt') %></dt><dd><time datetime="<%= shipment.shippedAt.toISOString() %>"><%= localTime(shipment.shippedAt) %></time></dd>
          <% if (shipment.deliveredAt) { %>
            <dt><%= t('shop.history.deliveredAt') %></dt><dd><time datetime="<%= shipment.deliveredAt.toISOString() %>"><%= localTime(shipment.deliveredAt) %></time></dd>
          <% } %>
        </dl>
      <% } else { %><p><%= t('shop.history.trackingLater') %></p><% } %>
    </section>
  <% } %>

  <section aria-labelledby="order-timeline">
    <h2 id="order-timeline"><%= t('shop.history.timeline') %></h2>
    <ol data-order-timeline>
      <% for (const { event, date } of timeline) { %>
        <li><%= t('shop.history.events.' + event) %> · <time datetime="<%= date.toISOString() %>"><%= localTime(date) %></time></li>
      <% } %>
    </ol>
  </section>

  <% if (canCancel) { %>
    <form method="post" action="<%= orderPath %>/cancel">
      <input type="hidden" name="csrf" value="<%= csrf %>" />
      <button class="btn btn-secondary" type="submit"><%= t('shop.cancel') %></button>
    </form>
  <% } %>
  <div class="account-actions"><a href="<%= paths.orders %>"><%= t('shop.orders') %></a><a href="<%= paths.shopping %>"><%= t('shop.continueShopping') %></a></div>
</main>
