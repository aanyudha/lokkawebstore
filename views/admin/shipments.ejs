<div class="admin-content commercial-page">
  <form method="get" action="<%= url %>" class="form-stack">
    <label>Order number <input name="orderNumber" value="<%= orderNumber %>" maxlength="40" required /></label>
    <button type="submit">Find order</button>
  </form>
  <% if (error) { %><p role="alert"><%= error %></p><% } %>
  <% if (orderNumber && !order && !error) { %><p role="status">Order not found.</p><% } %>
  <% if (!orderNumber) { %>
    <section aria-labelledby="shipments-ready">
      <h2 id="shipments-ready">Recently paid orders awaiting shipment</h2>
      <% if (readyOrders.length) { %>
        <ul>
          <% for (const ready of readyOrders) { %><li><a href="<%= url %>?orderNumber=<%= ready.orderNumber %>"><%= ready.orderNumber %></a></li><% } %>
        </ul>
      <% } else { %><p>No orders awaiting shipment.</p><% } %>
    </section>
  <% } %>
  <% if (order) { const shipment = order.shipment; const path = url + '/' + order.orderNumber; %>
    <section class="admin-section" aria-labelledby="shipment-order">
      <h2 id="shipment-order"><%= order.orderNumber %></h2>
      <dl>
        <dt>Order status</dt><dd><%= order.status %></dd>
        <% if (order.quote?.name) { %><dt>Quoted shipping</dt><dd><%= [order.quote.courierName, order.quote.serviceName ?? order.quote.name].filter(Boolean).join(' · ') %></dd><% } %>
        <dt>Customer shipping charge</dt><dd><%= formatIdr(order.shippingAmount) %></dd>
        <% if (order.status === 'PAID') { %><dt>Shipment status</dt><dd><%= shipment?.status ?? 'READY' %></dd><% } %>
        <% if (shipment) { %>
          <dt>Actual courier</dt><dd><%= shipment.courierName %></dd>
          <dt>Actual service</dt><dd><%= shipment.serviceName %></dd>
          <dt>Tracking number / Nomor resi</dt><dd><%= shipment.trackingNumber %></dd>
          <dt>Actual shipping cost</dt><dd><%= shipment.actualShippingCost === null ? 'Unrecorded' : formatIdr(shipment.actualShippingCost) %></dd>
        <% } %>
      </dl>
      <p><a href="/admin/orders/<%= order.orderNumber %>">View full order</a></p>
      <%- include('../partials/admin/shipment-actions.ejs', { canFulfill: order.status === 'PAID', shipment, path }) %>
    </section>
  <% } %>
</div>
