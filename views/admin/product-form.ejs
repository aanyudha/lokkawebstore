
<div class="admin-content">

<%- include('../partials/form-error.ejs') %>
<form method="post" action="/admin/products<%= values.id ? '/' + values.id : '' %>" class="form-stack" aria-describedby="<%= error ? 'form-error' : '' %>">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<label>Name<input name="name" required maxlength="200" value="<%= values.name || '' %>" />
</label>
<label>Slug<input name="slug" maxlength="150" value="<%= values.slug || '' %>" />
<small>Automatic if empty; keep to preserve URL.</small>
</label>
<label>Category<select name="categoryId">
<option value="">No category</option>
<% for (const category of categories) { %>
<option value="<%= category.id %>" <%= values.categoryId === category.id ? 'selected' : '' %>>
<%= category.name %> (<%= category.status %>)</option>
<% } %>
</select>
</label>
<label>Status<select name="status">
<% for (const status of ['draft','active','archived']) { %>
<option <%= values.status === status ? 'selected' : '' %>>
<%= status %>
</option>
<% } %>
</select>
</label>
<label class="check-label">
<input type="checkbox" name="featured" <%= values.featured ? 'checked' : '' %> /> LOKKA's Choice</label>
<label>Short description<textarea name="shortDescription" maxlength="500">
<%= values.shortDescription || '' %>
</textarea>
</label>
<label>Full description<textarea name="description" rows="8" maxlength="20000">
<%= values.description || '' %>
</textarea>
</label>
<label>SEO Title<input name="seoTitle" maxlength="150" value="<%= values.seoTitle || '' %>" />
</label>
<label>SEO Description<textarea name="seoDescription" maxlength="320">
<%= values.seoDescription || '' %>
</textarea>
</label>
<button>Save product</button>
</form>
<% if (values.id) { %>
<p><a href="/admin/products/<%= values.id %>/pricing">Product direct costs &amp; pricing analysis</a></p>
<p><a href="/admin/products/<%= values.id %>/showcase">Manage Product Showcase</a></p>
<% if (values.status === 'active') { %>
<p>
<a href="/produk/<%= values.slug %>">View public page ↗</a>
</p>
<% } %>
<form method="post" action="/admin/products/<%= values.id %>/archive">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<button class="secondary">Archive product</button>
</form>
<section id="variants" class="admin-section">
<h2>Variants</h2>
<% for (const saved of variants) { const variant = typeof variantValues !== 'undefined' && variantValues?.id === saved.id ? variantValues : saved; %>
<%- include('../partials/variant-form.ejs', { variant, productId: values.id }) %>
<% } %>
<h3>New variant</h3>
<%- include('../partials/variant-form.ejs', { variant: typeof variantValues !== 'undefined' && !variantValues?.id ? variantValues || {} : {}, productId: values.id }) %>
</section>
<section id="images" class="admin-section">
<h2>Product images</h2>
<p>JPEG, PNG, WebP · Maximum 5 images per upload, 10 MB per image.</p>
<form method="post" enctype="multipart/form-data" action="/admin/products/<%= values.id %>/images" class="form-stack">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<label>Alt text<input name="altText" maxlength="300" />
</label>
<label>Image<input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple required />
</label>
<button>Upload images</button>
</form>
<div class="media-grid">
<% for (const image of images) { %>
<article>
<img src="/admin/products/<%= values.id %>/images/<%= image.id %>/preview" width="<%= image.width %>" height="<%= image.height %>" alt="<%= image.altText || values.name %>" loading="lazy" />
<form method="post" action="/admin/products/<%= values.id %>/images/<%= image.id %>" class="form-stack">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<label>Alt text<input name="altText" maxlength="300" value="<%= image.altText || '' %>" />
</label>
<label>Sort order<input type="number" min="0" name="sortOrder" required value="<%= image.sortOrder %>" />
</label>
<label class="check-label">
<input type="checkbox" name="isPrimary" <%= image.isPrimary ? 'checked' : '' %> /> Primary image</label>
<button>Save image</button>
</form>
<form method="post" action="/admin/products/<%= values.id %>/images/<%= image.id %>/delete">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<button class="secondary">Delete image</button>
</form>
</article>
<% } %>
</div>
</section>
<% } else { %>
<p>Save product details, then add variants and images.</p>
<% } %>
</div>
