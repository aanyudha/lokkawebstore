
<div class="admin-content">

<%- include('../partials/form-error.ejs') %>
<form method="post" action="/admin/categories<%= values.id ? '/' + values.id : '' %>" class="form-stack" aria-describedby="<%= error ? 'form-error' : '' %>">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<label>Name<input name="name" required maxlength="150" value="<%= values.name || '' %>" />
</label>
<label>Slug<input name="slug" maxlength="150" value="<%= values.slug || '' %>" />
<small>Automatic from name if empty. Keep slug for stable URLs.</small>
</label>
<label>Parent category<select name="parentId">
<option value="">No parent</option>
<% for (const category of categories) { if (category.id !== values.id) { %>
<option value="<%= category.id %>" <%= values.parentId === category.id ? 'selected' : '' %>>
<%= category.name %>
</option>
<% } } %>
</select>
</label>
<label>Status<select name="status">
<% for (const status of ['active','hidden']) { %>
<option <%= values.status === status ? 'selected' : '' %>>
<%= status %>
</option>
<% } %>
</select>
</label>
<label>Sort order<input type="number" min="0" name="sortOrder" required value="<%= values.sortOrder ?? 0 %>" />
</label>
<label>Short description<textarea name="shortDescription" maxlength="500">
<%= values.shortDescription || '' %>
</textarea>
</label>
<label>SEO Title<input name="seoTitle" maxlength="150" value="<%= values.seoTitle || '' %>" />
</label>
<label>SEO Description<textarea name="seoDescription" maxlength="320">
<%= values.seoDescription || '' %>
</textarea>
</label>
<button>Save category</button>
</form>
</div>
