<main id="main" class="login-page">
<a class="brand" href="/">
<img src="/images/brand/lokka-logo.webp" width="160" height="80" alt="LOKKA" class="brand-logo"
  onerror="this.onerror=null;this.src='/images/lokka_logo.png';this.width=160;this.height=80;" />
</a>
<p class="eyebrow">Catalog administration</p>
<h1>Selamat datang kembali.</h1>
<%- include('../partials/form-error.ejs') %>
<form method="post" action="/admin/login" class="form-stack" aria-describedby="<%= error ? 'form-error' : '' %>">
<input type="hidden" name="csrf" value="<%= loginCsrf %>" />
<label>Email<input type="email" name="email" required maxlength="254" autocomplete="username" value="<%= values.email || '' %>" />
</label>
<label>Kata sandi<input type="password" name="password" required maxlength="128" autocomplete="current-password" />
</label>
<button>Masuk</button>
</form>
<p>
<a href="/">Kembali ke LOKKA</a>
</p>
</main>
