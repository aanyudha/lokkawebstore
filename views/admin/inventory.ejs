
<div class="admin-content">
<% if (!inventory.length) { %><%- include('../partials/admin/empty-state.ejs', {heading:'No variants yet',message:'Add variants in the product editor to manage their stock.'}) %><% } %>

<p>Low stock: <%= threshold %> or less.</p>
<%- include('../partials/form-error.ejs') %>
<div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable data table">
<table>
<thead>
<tr>
<th>Product / Variant</th>
<th>SKU</th>
<th>Status</th>
<th>Stock</th>
</tr>
</thead>
<tbody>
<% for (const row of inventory) { %>
<tr>
<td>
<a href="/admin/products/<%= row.product.id %>/edit">
<%= row.product.name %>
</a>
<br />
<%= row.variant.name %>
</td>
<td>
<%= row.variant.sku %>
</td>
<td>
<%- include('../partials/admin/status-badge.ejs', {status:row.variant.status}) %>
<% if (row.variant.stockQuantity <= threshold) { %>
<br />Low stock<% } %>
</td>
<td>
<form method="post" action="/admin/products/<%= row.product.id %>/variants/<%= row.variant.id %>/stock" class="stock-form">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<label>Stock <%= row.variant.sku %>
<input name="stockQuantity" type="number" min="0" required value="<%= values.id === row.variant.id ? values.stockQuantity : row.variant.stockQuantity %>" />
</label>
<button>Save</button>
</form>
</td>
</tr>
<% } %>
</tbody>
</table>
</div>
</div>
