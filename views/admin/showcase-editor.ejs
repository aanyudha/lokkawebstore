
<div class="admin-content">
<%- include('../partials/form-error.ejs') %>
<section class="admin-section">
<h2>Product identity</h2>
<dl class="commercial-totals">
<dt>Product</dt><dd><%= product.name %></dd>
<dt>Status</dt><dd><%- include('../partials/admin/status-badge.ejs', {status:product.status}) %></dd>
</dl>
</section>
<section class="admin-section">
<h2>Readiness</h2>
<dl class="commercial-totals">
<dt>Selected photos</dt><dd><%= readiness.selectedCount %> / <%= readiness.minimumRequired %> <%= readiness.hasEnoughImages ? 'PASS' : 'NEED MORE' %></dd>
<dt>Cover photo</dt><dd><%= readiness.hasCover ? 'Selected PASS' : 'NOT SELECTED' %></dd>
<dt>Source format</dt><dd><%= readiness.invalidSourceFormatCount === 0 && readiness.missingSourceCount === 0 ? 'JPG/PNG PASS' : readiness.missingSourceCount > 0 ? readiness.missingSourceCount + ' missing source' : readiness.invalidSourceFormatCount + ' WebP-only' %></dd>
<dt>Source metadata</dt><dd><%= readiness.missingSourceCount === 0 ? 'Available PASS' : 'Incomplete' %></dd>
<dt>Visual clarity</dt><dd><%= readiness.manualResolutionReviewCount === 0 ? 'N/A' : 'Review' %> <%= readiness.manualResolutionReviewCount > 0 ? 'MANUAL REVIEW' : '' %></dd>
<dt>Overall</dt><dd><strong><span class="status-badge" data-status="<%= readiness.overallState.toLowerCase() %>"><%= readiness.overallState %></span></strong></dd>
</dl>
<% if (readiness.issues.length) { %>
<ul><% for (const issue of readiness.issues) { %><li><%= issue %></li><% } %></ul>
<% } %>
</section>
<section class="admin-section">
<h2>Showcase status</h2>
<form method="post" action="/admin/products/<%= product.id %>/showcase/status" class="form-stack">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<label>Status<select name="status">
<% for (const s of ['draft','active','archived']) { %>
<option <%= showcase.status === s ? 'selected' : '' %>><%= s %></option>
<% } %>
</select></label>
<label>Notes<textarea name="notes" rows="3" maxlength="2000"><%= showcase.notes || '' %></textarea></label>
<button>Save status</button>
</form>
</section>
<section class="admin-section">
<h2>Selected media (<%= selections.length %>)</h2>
<% if (selections.length) { %>
<form method="post" action="/admin/products/<%= product.id %>/showcase/reorder" class="form-stack">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<div class="media-grid" data-showcase-grid>
<% for (const sel of selections) { %>
<article data-image-id="<%= sel.selection.productImageId %>">
<img src="/admin/products/<%= product.id %>/images/<%= sel.image.id %>/preview" width="<%= sel.image.width %>" height="<%= sel.image.height %>" alt="<%= sel.image.altText || product.name %>" loading="lazy" />
<p>
<%= sel.selection.isCover ? 'Cover' : '' %>
<%= sel.image.sourceFormat ? sel.image.sourceFormat.toUpperCase() : 'No source' %>
<%= sel.image.sourceWidth && sel.image.sourceHeight ? sel.image.sourceWidth + 'x' + sel.image.sourceHeight : '' %>
</p>
<p>
<button type="submit" name="order" value="<%= selections.map(s => s.selection.productImageId).join(',') %>" class="secondary" formaction="/admin/products/<%= product.id %>/showcase/reorder" hidden></button>
</p>
<div class="showcase-actions">
<form method="post" action="/admin/products/<%= product.id %>/showcase/cover" class="inline-form">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<input type="hidden" name="imageId" value="<%= sel.selection.productImageId %>" />
<button type="submit" class="secondary" <%= sel.selection.isCover ? 'disabled' : '' %>><%= sel.selection.isCover ? 'Cover' : 'Set cover' %></button>
</form>
<form method="post" action="/admin/products/<%= product.id %>/showcase/remove/<%= sel.selection.id %>" class="inline-form">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<button type="submit" class="secondary">Remove</button>
</form>
</div>
</article>
<% } %>
</div>
</form>
<% } else { %>
<p>No images selected for Showcase yet.</p>
<% } %>
</section>
<section class="admin-section">
<h2>Available product media</h2>
<% const selectedIds = new Set(selections.map(s => s.selection.productImageId)); %>
<% const available = images.filter(img => !selectedIds.has(img.id)); %>
<% if (available.length) { %>
<div class="media-grid">
<% for (const img of available) { %>
<article>
<img src="/admin/products/<%= product.id %>/images/<%= img.id %>/preview" width="<%= img.width %>" height="<%= img.height %>" alt="<%= img.altText || product.name %>" loading="lazy" />
<p><%= img.sourceFormat ? img.sourceFormat.toUpperCase() : 'No source' %> <%= img.sourceWidth && img.sourceHeight ? img.sourceWidth + 'x' + img.sourceHeight : '' %></p>
<form method="post" action="/admin/products/<%= product.id %>/showcase/select" class="inline-form">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<input type="hidden" name="imageId" value="<%= img.id %>" />
<button type="submit">Add to Showcase</button>
</form>
</article>
<% } %>
</div>
<% } else { %>
<p>All product images are already in Showcase, or no images exist.</p>
<% } %>
</section>
<section class="admin-section">
<h2>Upload new photos</h2>
<p>JPEG, PNG, WebP. Maximum 5 images per upload, 10 MB per image.</p>
<form method="post" enctype="multipart/form-data" action="/admin/products/<%= product.id %>/showcase/upload" class="form-stack">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<label>Alt text<input name="altText" maxlength="300" /></label>
<label>Image<input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple required /></label>
<button>Upload images</button>
</form>
</section>
</div>
