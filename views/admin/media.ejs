
<div class="admin-content">
<% if (!images.length) { %><%- include('../partials/admin/empty-state.ejs', {heading:'No product images yet',message:'Upload images from a product editor to see them here.'}) %><% } %>

<p>Manage images through the product edit page.</p>
<div class="media-grid">
<% for (const image of images) { const product = products.find(p => p.id === image.productId); %>
<article>
<a href="/admin/products/<%= image.productId %>/edit#images">
<img src="/admin/products/<%= image.productId %>/images/<%= image.id %>/preview" alt="<%= image.altText || product.name %>" width="<%= image.width %>" height="<%= image.height %>" loading="lazy" />
<h2>
<%= product.name %>
</h2>
</a>
<p>
<%= image.isPrimary ? 'Primary image' : 'Gallery' %>
</p>
</article>
<% } %>
</div>
</div>
