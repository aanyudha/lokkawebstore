
<div class="admin-content commercial-page">

<%- include('../partials/form-error.ejs') %>
<p>Manual income is cash-only in Accounting Lite, including the Product sales category. Revenue is recognized only from completed POS or Webstore sales. Record operating expenses here only when actually incurred; do not enter costs already included in sold-item HPP a second time.</p>
<p>Record real money that moved. POS income is posted automatically when a sale completes — it is shown read-only below and can never be edited here. Voided entries stay in history for audit and are excluded from every total.</p>

<section class="admin-section" id="add-transaction">
<h2>Add transaction</h2>
<% const form = action === '/admin/finance/income-expense' ? values : {}; const direction = form.direction === 'EXPENSE' ? 'EXPENSE' : 'INCOME'; %>
<form method="post" action="/admin/finance/income-expense" class="form-stack" data-finance-transaction>
<input type="hidden" name="csrf" value="<%= csrf %>" />
<label>Type
<select name="direction" required>
<option value="INCOME" <%= direction === 'INCOME' ? 'selected' : '' %>>Income</option>
<option value="EXPENSE" <%= direction === 'EXPENSE' ? 'selected' : '' %>>Expense</option>
</select>
</label>
<label>Category
<select name="category" required>
<option value="">Select category</option>
<% for (const [value, label] of categoryOptionsByDirection[direction]) { %><option value="<%= value %>" <%= form.category === value ? 'selected' : '' %>><%= label %></option><% } %>
</select>
</label>
<label>Amount (whole Rupiah)
<input name="amountRupiah" inputmode="numeric" pattern="[0-9]+" required value="<%= form.amountRupiah || '' %>" />
</label>
<label>Date &amp; time
<input name="occurredAt" type="datetime-local" required value="<%= form.occurredAt || defaultOccurredAt %>" />
</label>
<label>Description / notes
<textarea name="notes" maxlength="2000" rows="3"><%= form.notes || '' %></textarea>
</label>
<button>Save transaction</button>
</form>
<% for (const [direction, options] of Object.entries(categoryOptionsByDirection)) { %>
<template data-finance-categories="<%= direction %>">
<option value="">Select category</option>
<% for (const [value, label] of options) { %><option value="<%= value %>"><%= label %></option><% } %>
</template>
<% } %>
<noscript><p>Changing Type requires JavaScript to refresh categories. The server rejects categories that do not match the selected Type.</p></noscript>
</section>

<section class="admin-section">
<h2>Manual transaction history</h2>
<%- include('../partials/admin/list-search.ejs',{listing:history.listing,searchPath:'/admin/finance/income-expense',searchLabel:'Search transactions',searchPlaceholder:'Search transactions...'}) %>
<p>Manual entries and read-only automated sale entries share the current search and page. Cash Flow and Accounting totals are not filtered by this search.</p>
<% if (!history.manual.length) { %><p>No manual transactions match this page/search.</p><% } else { %>
<div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable manual transaction table">
<table>
<thead>
<tr><th scope="col">Date (UTC)</th><th scope="col">Type</th><th scope="col">Category</th><th scope="col">Amount</th><th scope="col">Description</th><th scope="col">Status</th><th scope="col">Action</th></tr>
</thead>
<tbody>
<% for (const row of history.manual) { %>
<tr data-manual-status="<%= row.status %>">
<td><time datetime="<%= row.occurredAt.toISOString() %>"><%= row.occurredAt.toISOString().replace('T', ' ').slice(0, 16) %></time></td>
<td><%= row.type === 'OPENING_BALANCE' ? 'Opening balance' : row.direction === 'INCOME' ? 'Income' : 'Expense' %></td>
<td><%= categoryLabels[row.category] ?? row.category %></td>
<td><%= row.direction === 'EXPENSE' ? '−' : '' %><%= formatIdr(row.amountRupiah) %></td>
<td><%= row.notes ?? '' %><% if (row.voidReason) { %><br /><small>Void reason: <%= row.voidReason %></small><% } %></td>
<td><%- include('../partials/admin/status-badge.ejs', { status: row.status }) %></td>
<td>
<% if (row.status === 'POSTED') { %>
<form method="post" action="/admin/finance/income-expense/<%= row.id %>/void" class="stock-form">
<input type="hidden" name="csrf" value="<%= csrf %>" />
<label>Reason for voiding <%= categoryLabels[row.category] ?? row.category %>
<input name="reason" maxlength="2000" required />
</label>
<button>Void entry</button>
</form>
<% } else { %>Read-only<% } %>
</td>
</tr>
<% } %>
</tbody>
</table>
</div>
<% } %>
</section>

<section class="admin-section">
<h2>POS income — system generated, read-only</h2>
<% if (!history.automated.length) { %><p>No automated sale entries match this page/search.</p><% } else { %>
<div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable POS income table">
<table>
<thead>
<tr><th scope="col">Date (UTC)</th><th scope="col">Reference</th><th scope="col">Source</th><th scope="col">Amount</th><th scope="col">Status</th></tr>
</thead>
<tbody>
<% for (const row of history.automated) { %>
<tr data-pos-income>
<td><time datetime="<%= row.occurredAt.toISOString() %>"><%= row.occurredAt.toISOString().replace('T', ' ').slice(0, 16) %></time></td>
<td><%= row.transactionNumber ?? '—' %></td>
<td><%= sourceLabels[row.source] ?? row.source %></td>
<td><%= formatIdr(row.amountRupiah) %></td>
<td><%- include('../partials/admin/status-badge.ejs', { status: row.status }) %></td>
</tr>
<% } %>
</tbody>
</table>
</div>
<% } %>
<p>One sale posts income exactly once. Correct a wrong POS income by fixing the sale, never by editing the ledger.</p>
</section>
<%- include('../partials/admin/list-pagination.ejs',{listing:history.listing}) %>
</div>
