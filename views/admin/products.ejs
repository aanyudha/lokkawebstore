
<div class="admin-content">
<% if (!products.length) { %><%- include('../partials/admin/empty-state.ejs', {heading:'No products yet',message:'Add a product to begin building your catalog.'}) %><% } %>


<div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable data table">
<table>
<thead>
<tr>
<th>Product</th>
<th>Status</th>
<th>Slug</th>
</tr>
</thead>
<tbody>
<% for (const product of products) { %>
<tr>
<td>
<a href="/admin/products/<%= product.id %>/edit">
<%= product.name %>
</a>
</td>
<td>
<%- include('../partials/admin/status-badge.ejs', {status:product.status}) %>
</td>
<td>
<%= product.slug %>
</td>
</tr>
<% } %>
</tbody>
</table>
</div>
</div>
