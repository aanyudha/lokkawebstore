
<div class="admin-content">
<% if (!categories.length) { %><%- include('../partials/admin/empty-state.ejs', {heading:'No categories yet',message:'Create a category to organize your products.'}) %><% } %>


<div class="table-scroll" tabindex="0" role="region" aria-label="Scrollable data table">
<table>
<thead>
<tr>
<th>Name</th>
<th>Slug</th>
<th>Status</th>
<th>Sort order</th>
</tr>
</thead>
<tbody>
<% for (const category of categories) { %>
<tr>
<td>
<a href="/admin/categories/<%= category.id %>/edit">
<%= category.name %>
</a>
</td>
<td>
<%= category.slug %>
</td>
<td>
<%- include('../partials/admin/status-badge.ejs', {status:category.status}) %>
</td>
<td>
<%= category.sortOrder %>
</td>
</tr>
<% } %>
</tbody>
</table>
</div>
</div>
