<%- include('../partials/admin-header.ejs') %>
<main id="main" class="admin-main">
<h1>Categories</h1>
<a class="button" href="/admin/categories/new">Tambah kategori</a>
<div class="table-scroll">
<table>
<thead>
<tr>
<th>Nama</th>
<th>Slug</th>
<th>Status</th>
<th>Urutan</th>
</tr>
</thead>
<tbody>
<% for (const category of categories) { %>
<tr>
<td>
<a href="/admin/categories/<%= category.id %>/edit">
<%= category.name %>
</a>
</td>
<td>
<%= category.slug %>
</td>
<td>
<%= category.status %>
</td>
<td>
<%= category.sortOrder %>
</td>
</tr>
<% } %>
</tbody>
</table>
</div>
</main>
