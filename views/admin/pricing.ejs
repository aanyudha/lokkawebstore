<%- include('../partials/admin-header.ejs') %>
<main id="main" class="admin-main commercial-page"><h1>Product costs &amp; pricing · <%= product.name %></h1><p><a href="/admin/products/<%= product.id %>/edit">Back to product editor</a> · <a href="/admin/finance/overhead">Manage global overhead</a></p>
<%- include('../partials/form-error.ejs') %>
<section class="admin-section"><h2>Direct product costs per unit</h2><p>Materials, labor and packaging for this product only. Business-wide costs belong in Global overhead.</p>
<% for (const saved of [...costs,{category:'DIRECT_MATERIAL',sortOrder:0}]) { const dest = '/admin/products/' + product.id + '/costs' + (saved.id ? '/' + saved.id : ''); const form = action === dest ? values : saved; %>
<details <%= !saved.id || action === dest ? 'open' : '' %>><summary><%= saved.id ? saved.name + ' · ' + formatIdr(saved.amountRupiah) : 'Add direct unit cost' %></summary><form method="post" action="<%= dest %>" class="form-stack"><input type="hidden" name="csrf" value="<%= csrf %>" /><%- include('../partials/commercial-fields.ejs',{form,fields:[['name','Cost name'],['category','Category','text',[['DIRECT_MATERIAL','Direct material'],['DIRECT_LABOR','Direct labor'],['PACKAGING','Packaging'],['OTHER','Other']]],['amountRupiah','Amount per unit (whole Rupiah)'],['notes','Notes (optional)'],['sortOrder','Sort order','number']]}) %><button>Save direct cost</button></form>
<% if (saved.id) { %><form method="post" action="<%= dest %>/delete"><input type="hidden" name="csrf" value="<%= csrf %>" /><button class="secondary">Remove direct cost</button></form><% } %></details>
<% } %></section>
<section class="admin-section"><h2>Pricing analysis</h2>
<% if (overhead) { %><p>Using <strong><%= new Intl.DateTimeFormat('en',{month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(overhead.period.periodMonth)) %></strong> overhead allocation. Forecast: <%= overhead.period.forecastUnitsRemaining %> remaining units.</p><% } else { %><p role="status">No open overhead period. Open a period to calculate a complete recommendation. Economics below exclude unconfigured overhead.</p><% } %>
<dl class="commercial-totals"><dt>Direct unit cost</dt><dd><%= formatIdr(direct) %></dd><dt>Current global overhead / unit</dt><dd><%= overhead ? formatIdr(overhead.perUnit) : 'Not configured' %></dd><dt>Estimated full unit cost</dt><dd><%= formatIdr(full) %></dd><dt>Recommended selling price</dt><dd><strong><%= recommended === null ? 'Awaiting open period' : formatIdr(recommended) %></strong></dd></dl>
<p>Recommendations are advisory. Saving costs, forecasts or this profile does not change selling prices and does not recover overhead. Set each actual price explicitly in the variant editor.</p>
<form method="post" action="/admin/products/<%= product.id %>/pricing" class="form-stack"><input type="hidden" name="csrf" value="<%= csrf %>" />
<%- include('../partials/commercial-fields.ejs',{form:error && action === '/admin/products/' + product.id + '/pricing' ? values : {...profile,profitPercent:percentText(profile.profitBps),taxPercent:percentText(profile.taxBps)},fields:[['method','Profit method','text',[['TARGET_MARGIN','Target margin on revenue'],['MARKUP','Markup on cost']]],['profitPercent','Target margin / markup (%)'],['taxPercent','Estimated tax reserve (%) — internal simulation only'],['roundingRupiah','Round recommendation up to','text',[['1','Rp1'],['1000','Rp1,000'],['5000','Rp5,000'],['10000','Rp10,000']]]]}) %>
<p>The reserve is a planning estimate, defaults to 0%, and is never shown to customers or collected as tax.</p><button>Save pricing profile</button></form>
<h3>Actual selling-price economics</h3><p>Reserve rounds up to whole Rupiah; margin displays two decimals truncated toward zero.</p>
<div class="table-scroll"><table><thead><tr><th>Variant</th><th>Selling price</th><th>Full cost</th><th>Estimated reserve</th><th>Estimated profit</th><th>Actual margin</th></tr></thead><tbody><% for (const v of variants) { %><tr><th><%= v.name %> · <%= v.sku %> (<%= v.status %>)</th><td><%= formatIdr(v.price) %></td><td><%= formatIdr(full) %></td><td><%= formatIdr(v.reserve) %></td><td><%= formatIdr(v.profit) %></td><td><%= v.margin === null ? '—' : v.margin + '%' %></td></tr><% } %></tbody></table></div>
</section></main>
