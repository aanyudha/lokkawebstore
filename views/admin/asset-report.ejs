<article lang="<%= view.language %>" class="investor-report executive-report" data-investor-report="assets">
<% const t = view.t; const asset = report.asset; %>
<section class="report-primary-page" data-report-primary="asset-snapshot">
<%- include('../partials/admin/report-header.ejs',{reportTitle:'ASSET REGISTER + VALUATION'}) %>
<p class="report-section-label"><%= t("01 / Executive Snapshot") %></p>
<h3><%= t("Recorded assets, at a glance") %></h3>
<p class="report-intro"><%= t("LOKKA holds inventory valued at recorded HPP and fixed assets valued at acquisition cost. Retail value is a separate commercial indicator and is not included in recorded assets.") %></p>
<dl class="report-kpis">
<div class="report-kpi report-kpi--lead"><dt><%= t("Total Recorded Assets") %></dt><dd data-report-combined><%= formatIdr(asset.combinedValue) %></dd></div>
<div class="report-kpi"><dt><%= t("Inventory at HPP") %></dt><dd data-report-hpp><%= formatIdr(asset.hppValue) %></dd></div>
<div class="report-kpi"><dt><%= t("Fixed Asset Acquisition Value") %></dt><dd data-report-fixed><%= formatIdr(asset.fixedValue) %></dd></div>
<div class="report-kpi"><dt><%= t("Inventory Retail Value") %></dt><dd data-report-retail><%= formatIdr(asset.retailValue) %></dd></div>
<div class="report-kpi"><dt><%= t("Potential Gross Spread") %></dt><dd data-report-spread><%= formatIdr(asset.grossSpread) %></dd></div>
<div class="report-kpi"><dt><%= t("Known Inventory Units") %></dt><dd><span data-report-units><%= asset.knownUnits %></span> <small><%= view.unitLabel %></small></dd></div>
</dl>
<section class="report-block"><h3><%= t("Asset mix") %></h3>
<table class="report-summary-table" data-asset-mix><caption><%= t("Share of recorded inventory and fixed assets") %></caption><thead><tr><th scope="col"><%= t("Asset Class") %></th><th scope="col"><%= t("Value") %></th><th scope="col"><%= t("Share of Recorded Assets") %></th></tr></thead><tbody>
<tr><th scope="row"><%= t("Inventory at HPP") %></th><td><%= formatIdr(asset.hppValue) %></td><td><%= view.inventoryShare %></td></tr>
<tr><th scope="row"><%= t("Fixed Assets") %></th><td><%= formatIdr(asset.fixedValue) %></td><td><%= view.fixedShare %></td></tr>
</tbody><tfoot><tr><th scope="row"><%= t("Total Recorded Assets") %></th><td><%= formatIdr(asset.combinedValue) %></td><td><%= view.totalShare %></td></tr></tfoot></table>
</section>
</section>
<section class="report-primary-page" data-report-primary="asset-position">
<p class="report-section-label"><%= t("02 / Inventory & Asset Position") %></p><h3><%= t("Inventory supports the commercial opportunity") %></h3>
<dl class="report-facts">
<div><dt><%= t("Total products") %></dt><dd data-product-count><%= view.productCount %></dd></div>
<div><dt><%= t("Known-stock products") %></dt><dd><%= view.knownStockProducts %></dd></div>
<div><dt><%= t("Products requiring stock confirmation") %></dt><dd><%= view.unknownStockProducts %></dd></div>
<div><dt><%= t("Known inventory units") %></dt><dd><%= asset.knownUnits %> <%= view.unitLabel %></dd></div>
<div><dt><%= t("Inventory HPP value") %></dt><dd><%= formatIdr(asset.hppValue) %></dd></div>
<div><dt><%= t("Inventory retail value") %></dt><dd><%= formatIdr(asset.retailValue) %></dd></div>
<div><dt><%= t("Potential gross spread") %></dt><dd><%= formatIdr(asset.grossSpread) %></dd></div>
</dl>
<p class="report-takeaway"><%= t("Retail capacity indicates the value of selling known inventory at current prices. The gross spread is not guaranteed profit; it excludes operating and selling costs.") %></p>
<section class="report-block"><h3><%= t("Fixed asset base") %></h3>
<p class="report-emphasis"><strong><%= formatIdr(asset.fixedValue) %></strong> <%= t("in active acquisition value across") %> <strong><%= view.activeFixedCount %> <%= t("active asset records") %></strong>.</p>
<p><%= t("These are recorded acquisition values, with no depreciation or book-value calculation applied. Disposed assets remain in the detailed register.") %></p>
</section>
<section class="report-block"><h3><%= t("Key valuation notes") %></h3><ul class="report-key-notes">
<li><%= t("Inventory uses recorded HPP/direct cost.") %></li><li><%= t("Fixed assets use recorded acquisition value.") %></li><li><%= t("Retail value is not recorded asset value.") %></li><li><%= t("Unknown stock/cost is excluded where applicable.") %></li><li><%= t("No depreciation or book value is calculated.") %></li>
</ul></section>
<nav class="report-appendix-index" aria-label="<%= t("Asset report appendices") %>"><h3><%= t("Supporting detail") %></h3><a href="#asset-appendix-a"><%= t("Appendix A â€” Detailed Inventory") %></a><a href="#asset-appendix-b"><%= t("Appendix B â€” Fixed Asset Detail") %></a><a href="#asset-appendix-c"><%= t("Appendix C â€” Basis of Valuation") %></a></nav>
</section>
<div class="report-appendices">
<section class="report-appendix" id="asset-appendix-a" data-report-appendix="A"><p class="report-section-label"><%= t("Appendix A") %></p><h3><%= t("Detailed Inventory") %></h3>
<p><%= t("Nonarchived products, including draft products and inactive variants awaiting publication details. Archived catalog is excluded.") %></p>
<p data-report-incomplete><%= asset.incompleteCount %> <%= t("incomplete items:") %> <%= asset.unknownStockCount %> <%= t("with unspecified stock;") %> <%= asset.unknownCostCount %> <%= t("with unknown HPP. Unavailable is distinct from confirmed zero.") %></p>
<div class="table-scroll" tabindex="0" role="region" aria-label="<%= t("Inventory valuation") %>"><table><thead><tr><th scope="col"><%= t("Product") %></th><th scope="col"><%= t("SKU") %></th><th scope="col"><%= t("Stock Qty") %></th><th scope="col"><%= t("Unit") %></th><th scope="col"><%= t("HPP / unit") %></th><th scope="col"><%= t("Inventory value") %></th><th scope="col"><%= t("Selling price / unit") %></th><th scope="col"><%= t("Retail value") %></th></tr></thead><tbody>
<% for (const row of asset.inventory) { %><tr><th scope="row"><%= row.product.name %></th><td><%= row.variant.sku %></td><td><%= row.variant.stockKnown ? row.variant.stockQuantity : t("Unknown stock") %></td><td><%= row.variant.unit ?? t("Unavailable") %></td><td><%= row.hpp === null ? t("Unavailable") : formatIdr(row.hpp) %></td><td><%= row.inventoryValue === null ? t("Unavailable") : formatIdr(row.inventoryValue) %></td><td><%= formatIdr(row.variant.price) %></td><td><%= row.retailValue === null ? t("Unavailable") : formatIdr(row.retailValue) %></td></tr><% } %>
</tbody><tfoot><tr><th scope="row" colspan="2"><%= t("Known totals") %></th><td><%= asset.knownUnits %></td><td></td><td></td><td><%= formatIdr(asset.hppValue) %></td><td></td><td><%= formatIdr(asset.retailValue) %></td></tr></tfoot></table></div>
</section>
<section class="report-appendix report-appendix--new-page" id="asset-appendix-b" data-report-appendix="B"><p class="report-section-label"><%= t("Appendix B") %></p><h3><%= t("Fixed Asset Detail") %></h3>
<p><%= t("Acquisition Value. Fixed assets are presented at recorded acquisition value, not depreciated book value. Disposed rows remain visible and are excluded from active totals.") %></p>
<div class="table-scroll" tabindex="0" role="region" aria-label="<%= t("Fixed asset valuation") %>"><table><thead><tr><th scope="col"><%= t("Asset") %></th><th scope="col"><%= t("Quantity") %></th><th scope="col"><%= t("Unit") %></th><th scope="col"><%= t("Acquisition cost / unit") %></th><th scope="col"><%= t("Total acquisition value") %></th><th scope="col"><%= t("Status") %></th></tr></thead><tbody>
<% for (const row of asset.fixed) { %><tr><th scope="row"><%= row.assetName %></th><td><%= row.quantity %></td><td><%= row.unit %></td><td><%= formatIdr(row.acquisitionCostPerUnit) %></td><td><%= formatIdr(row.total) %></td><td><%= t(row.status) %></td></tr><% } %>
</tbody><tfoot><tr><th scope="row" colspan="4"><%= t("Active acquisition value") %></th><td><%= formatIdr(asset.fixedValue) %></td><td><%= t("Disposed excluded") %></td></tr></tfoot></table></div>
</section>
<section class="report-appendix report-appendix--new-page" id="asset-appendix-c" data-report-appendix="C"><p class="report-section-label"><%= t("Appendix C") %></p><h3><%= t("Basis of Valuation") %></h3>
<dl class="report-methods"><dt><%= t("Inventory value") %></dt><dd><%= t("Confirmed stock Ã— recorded current HPP/direct cost per unit.") %></dd><dt><%= t("Retail value") %></dt><dd><%= t("Confirmed stock Ã— current recorded selling price per unit.") %></dd><dt><%= t("Potential gross spread") %></dt><dd><%= t("Comparable retail value âˆ’ HPP value for the same complete stock-and-cost cohort. Comparable retail:") %> <%= formatIdr(asset.comparativeRetail) %>.</dd><dt><%= t("Fixed acquisition value") %></dt><dd><%= t("Quantity Ã— acquisition cost per unit/pack, using the owner's register classification. Active rows contribute to the active total.") %></dd><dt><%= t("Combined recorded asset value") %></dt><dd><%= t("Known inventory at HPP + active fixed asset acquisition value. Retail value is excluded.") %></dd></dl>
<ul class="report-key-notes"><li><%= t("Unknown quantities are not factual zero. Quantity-unknown rows are excluded from stock-derived totals; a confirmed zero remains known zero.") %></li><li><%= t("Known-unit and retail totals require known quantity. HPP and comparative gross-spread totals also require known HPP. Missing cost components are unknown; explicitly recorded zero cost is known zero.") %></li><li><%= t("Product counts group canonical product IDs. A product requires stock confirmation if any included variant has unknown quantity. Active fixed asset count refers to register records, not the sum of their quantities.") %></li><li><%= t("Displayed asset shares use recorded asset value as denominator and are rounded to two decimal places; no share is shown for a zero denominator.") %></li><li><%= t("Fixed assets follow the owner's classification. No depreciation, useful life, salvage value or book value is inferred.") %></li><li><%= t("Source SKUs beginning LOKKA-SYS-OWNER are system-generated. Accessories/apparel categories are operational classifications; source product names are preserved.") %></li><li><%= t("Missing weights and media do not invent facts. Nonarchived draft inventory is included; operational details are maintained in Products, Inventory and Fixed Assets.") %></li></ul>
</section></div>
</article>
