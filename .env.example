# ─────────────────────────────────────────────────────────────────────────────
# LOKKA Webstore environment
# ─────────────────────────────────────────────────────────────────────────────
# Exactly ONE server runtime mode is selected through APP_RUNTIME (validated at
# startup): fastify | docker. Default: fastify.
#   fastify -> npm start launches the compiled Fastify app directly with Node.
#   docker  -> npm run build builds the LOKKA app image; npm start ensures the
#              app container runs. Existing PostgreSQL data stays untouched.
# Both modes use the identical workflow:  npm install && npm run build && npm start
#
# Each runtime depends on EXACTLY ONE database variable and never falls back to
# the other variable or to any default credential. If the required variable is
# missing, LOKKA fails immediately with a clear message:
#   APP_RUNTIME=fastify requires DATABASE_URL.
#   APP_RUNTIME=docker  requires DATABASE_URL_DOCKER.
# Credential values are never printed.
# -----------------------------------------------------------------------------
NODE_ENV=development

# HOST is the Fastify bind address. 0.0.0.0 accepts container/LAN connections;
# stop with a firewall rule if you must restrict access. NOT the public URL.
# In APP_RUNTIME=docker the container always binds 0.0.0.0 regardless.
HOST=0.0.0.0
# PORT is the configured application port (validated 1-65535).
PORT=3000
POSTGRES_PORT=5432

# APP_URL is the CANONICAL EXTERNAL ORIGIN users actually access. Never a bind
# address; HOST is where Fastify listens, APP_URL is how users reach LOKKA.
# Examples: http://127.0.0.1:3000 | http://192.168.1.200:3000 | https://lokka.id
APP_URL=http://127.0.0.1:3000
# Optional comma-separated extra browser origins for development/test ONLY.
# Example LAN development: APP_URL=http://192.168.1.122:3000 and
# DEV_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Every protocol/host/port must be explicit. Production ignores this setting.
DEV_ALLOWED_ORIGINS=

# ============================================================================
# MODE 1 - FASTIFY (native/private/managed PostgreSQL)
# ============================================================================
# APP_RUNTIME=fastify runs the compiled Fastify application directly with Node.
# It reads DATABASE_URL ONLY and ignores DATABASE_URL_DOCKER. Point DATABASE_URL
# at a PostgreSQL instance reachable from the host: locally installed, privately
# hosted, or managed. Docker is NEVER invoked by this mode and is NOT required
# to start the application.
APP_RUNTIME=fastify
DATABASE_URL=postgresql://lokka:CHANGE_ME@127.0.0.1:5432/lokka
# Not used in fastify mode. Keep empty.
DATABASE_URL_DOCKER=

# ============================================================================
# MODE 2 - DOCKER (application container + Docker PostgreSQL)
# ============================================================================
# APP_RUNTIME=docker runs the LOKKA application container. Inside the container,
# PostgreSQL is reached through DATABASE_URL_DOCKER ONLY (host `postgres`, the
# Compose service name); DATABASE_URL is ignored. DATABASE_URL_DOCKER must be
# set explicitly in EVERY environment, including development - there is no
# default and no fallback.
# To use this mode, comment out the FASTIFY block above and uncomment the
# DOCKER block below:
# APP_RUNTIME=docker
# DATABASE_URL=
# DATABASE_URL_DOCKER=postgresql://lokka:CHANGE_ME@postgres:5432/lokka

# Enable only when Fastify is behind a trusted loopback reverse proxy
# (e.g. Nginx proxying to 127.0.0.1:3000). Never trust arbitrary forwarding headers.
TRUST_PROXY=false
LOG_LEVEL=info
LOW_STOCK_THRESHOLD=5
CATALOG_STORAGE_ROOT=storage/uploads/catalog
PAYMENT_PROVIDER=disabled
DOKU_ENV=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_NOTIFICATION_URL=
SHIPPING_RATE_PROVIDER=disabled
JNT_TARIFF_URL=
JNT_TARIFF_CUSTOMER_NAME=
JNT_TARIFF_KEY=
JNT_TARIFF_ORIGIN_CODES=
JNT_TARIFF_DESTINATION_CODES=
