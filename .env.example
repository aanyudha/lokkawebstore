# ─────────────────────────────────────────────────────────────────────────────
# LOKKA Webstore environment
# ─────────────────────────────────────────────────────────────────────────────
# Exactly ONE server runtime mode is selected through APP_RUNTIME (validated at
# startup): fastify | docker. Default: fastify.
#   fastify  -> npm start launches the compiled Fastify app directly with Node.
#   docker   -> npm run build builds the LOKKA app image; npm start ensures the
#               app container runs. Existing PostgreSQL data stays untouched.
# Both modes use the identical workflow:  npm install && npm run build && npm start
# ─────────────────────────────────────────────────────────────────────────────
APP_RUNTIME=fastify
NODE_ENV=development

# HOST is the Fastify bind address. 0.0.0.0 accepts container/LAN connections;
# stop with a firewall rule if you must restrict access. NOT the public URL.
# In APP_RUNTIME=docker the container always binds 0.0.0.0 regardless.
HOST=0.0.0.0
# PORT is the configured application port (validated 1-65535).
PORT=3000
POSTGRES_PORT=5432

# APP_URL is the CANONICAL EXTERNAL ORIGIN users actually access. Never a bind
# address; HOST is where Fastify listens, APP_URL is how users reach LOKKA.
# Examples: http://127.0.0.1:3000 | http://192.168.1.200:3000 | https://lokka.id
APP_URL=http://127.0.0.1:3000

# Database connection for APP_RUNTIME=fastify (host reaches PostgreSQL directly).
DATABASE_URL=postgresql://lokka:development_only@127.0.0.1:5432/lokka

# Database connection for APP_RUNTIME=docker. Inside the app container PostgreSQL
# is reached by Docker service name, so 127.0.0.1 is wrong there.
# DEVELOPMENT ONLY: if unset, the Compose development default below (a
# development_only credential) is used. This fallback is refused for
# NODE_ENV=production: a production Docker start without DATABASE_URL_DOCKER
# fails with an actionable error instead of silently using development
# credentials. Set DATABASE_URL_DOCKER explicitly for production. Credential
# values are never printed.
# DATABASE_URL_DOCKER=postgresql://lokka:development_only@postgres:5432/lokka

# Enable only when Fastify is behind a trusted loopback reverse proxy
# (e.g. Nginx proxying to 127.0.0.1:3000). Never trust arbitrary forwarding headers.
TRUST_PROXY=false
LOG_LEVEL=info
LOW_STOCK_THRESHOLD=5
CATALOG_STORAGE_ROOT=storage/uploads/catalog
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_ENVIRONMENT=sandbox
BITESHIP_API_KEY=
BITESHIP_ENVIRONMENT=sandbox